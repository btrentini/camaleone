{
  "name": "camaleone",
  "displayName": "Camaleone",
  "description": "VS Code Marketplace/Open VSX extension for VS Code, Cursor, and compatible IDE window colours.",
  "version": "0.1.9",
  "publisher": "trentinium",
  "license": "MIT",
  "icon": "assets/icons/ico/camaleone_transparent.ico",
  "repository": {
    "type": "git",
    "url": "https://github.com/btrentini/camaleone.git"
  },
  "bugs": {
    "url": "https://github.com/btrentini/camaleone/issues"
  },
  "homepage": "https://www.trentini.fyi/camaleone/",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:camaleone.controls"
  ],
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "camaleone",
    "vscode",
    "cursor",
    "ide",
    "workbench",
    "themes",
    "colors",
    "colours",
    "gradient",
    "gradients",
    "presets",
    "favourites",
    "favorites",
    "sober-mode",
    "visual-controls",
    "surface-controls",
    "workspace-identity",
    "window-colors",
    "activity-bar",
    "status-bar",
    "title-bar",
    "remote-ssh"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "camaleone.openPicker",
        "title": "Open Colour Picker",
        "category": "Camaleone",
        "icon": {
          "light": "assets/icons/ico/camaleone-activity-compact-light.ico",
          "dark": "assets/icons/ico/camaleone-activity-compact-dark.ico"
        }
      },
      {
        "command": "camaleone.quickApply",
        "title": "Quick Apply Without Webview",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.applyConfigured",
        "title": "Apply Configured Colors",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.clear",
        "title": "Restore Previous Colors",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.resetToDefault",
        "title": "Reset to IDE Defaults",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.surpriseMe",
        "title": "Surprise Me",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.saveFavorite",
        "title": "Save Current Colors as Favourite",
        "category": "Camaleone"
      },
      {
        "command": "camaleone.applyFavorite",
        "title": "Apply Favourite Colors",
        "category": "Camaleone"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "camaleone",
          "title": "Camaleone",
          "icon": "assets/icons/png/camaleone-activity.png"
        }
      ]
    },
    "views": {
      "camaleone": [
        {
          "type": "webview",
          "id": "camaleone.controls",
          "name": "Setup",
          "icon": "assets/icons/ico/camaleone-activity-compact.ico",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Camaleone",
      "properties": {
        "camaleone.startColor": {
          "type": "string",
          "default": "#0ea5e9",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Start color for the workbench gradient."
        },
        "camaleone.endColor": {
          "type": "string",
          "default": "#f97316",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "End color for the workbench gradient."
        },
        "camaleone.intensity": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "description": "How strongly the gradient colors are blended into the workbench."
        },
        "camaleone.includeEditorAccent": {
          "type": "boolean",
          "default": false,
          "description": "Also tint editor accent surfaces such as selection, line highlight, cursor, and links."
        },
        "camaleone.monochromatic": {
          "type": "boolean",
          "default": false,
          "description": "Use the start color as the base and derive panel colors from a harmony rule."
        },
        "camaleone.sober": {
          "type": "boolean",
          "default": true,
          "description": "Keep most managed workbench surfaces at #1e1e1e while tinting only the title bar, activity bar, and status bar."
        },
        "camaleone.colorRelationship": {
          "type": "string",
          "default": "manual",
          "enum": [
            "manual",
            "analogous",
            "complementary"
          ],
          "description": "How the palette moves between the two selected colors."
        },
        "camaleone.panelHarmony": {
          "type": "string",
          "default": "manual",
          "enum": [
            "manual",
            "analogous",
            "complementary"
          ],
          "description": "Legacy color-theory rule used for panels when monochromatic mode is enabled."
        },
        "camaleone.surfaceOverrides": {
          "type": "object",
          "default": {},
          "description": "Optional per-surface color overrides keyed by surface id."
        }
      }
    }
  },
  "scripts": {
    "test": "node --check extension.js && node test/run-tests.js",
    "publish:marketplaces": "scripts/publish_marketplaces.sh",
    "vscode:prepublish": "npm test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {}
}
